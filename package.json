{
  "name": "corral",
  "productName": "Corral",
  "version": "0.1.0",
  "description": "Tray app to watch and tidy up local AI coding agents, dev-server ports, RAM and disk",
  "main": "./out/main/index.js",
  "author": "yeonjin1357",
  "license": "MIT",
  "homepage": "https://github.com/yeonjin1357/pitwall",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "icon": "node --experimental-strip-types scripts/make-icon.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "pretendard": "^1.3.9",
    "prettier": "^3.9.10",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
